#!/usr/bin/env python3

import hashlib
import json
from pathlib import Path
import sys
import tarfile


def read_control(filename):
    with filename.open(encoding="utf-8") as stream:
        control = json.load(stream)
    if not isinstance(control, dict):
        raise ValueError(f"{filename} must contain a JSON object")
    for field in ("Package", "Version"):
        if field not in control:
            raise ValueError(f"{filename} does not contain a '{field}' field")
    return control


def package_files():
    files = [Path("control.json")]
    for filename in Path("files").rglob("*"):
        relative_name = filename.as_posix()
        if not filename.is_file():
            continue
        if "flymake" in relative_name or relative_name.endswith("~"):
            continue
        files.append(filename)
    return [files[0], *sorted(files[1:], key=lambda path: path.as_posix())]


def file_digest(filename, algorithm):
    digest = hashlib.new(algorithm)
    with filename.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def make_package():
    control_filename = Path("control.json")
    control = read_control(control_filename)
    archive_filename = Path(f"{control['Package']}_{control['Version']}.tar.gz")

    with tarfile.open(archive_filename, "w:gz") as archive:
        for filename in package_files():
            archive.add(filename, arcname=filename.as_posix(), recursive=False)

    control["SHA1"] = file_digest(archive_filename, "sha1")
    control["SHA256"] = file_digest(archive_filename, "sha256")
    control["MD5sum"] = file_digest(archive_filename, "md5")
    print(json.dumps(control, indent=3, ensure_ascii=False))


def main():
    try:
        make_package()
    except (OSError, ValueError, tarfile.TarError) as error:
        print(f"{Path(sys.argv[0]).name}: Error! {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
